# Environment for the agent gateway. Consumed by quadlets/agentgateway.container
# through EnvironmentFile=; the config template references these names, so a
# variable that is missing here is a literal `$NAME` sent upstream.
#
# The provider keys stay in this container: clients authenticate to the gateway,
# never to DeepSeek/Z.ai/OpenRouter. That is the whole point of a shared gateway
# for several development environments.

AGENTGW_SESSION_KEY=(generate this using `openssl rand -hex 32`)
DEEPSEEK_API_KEY=(get this from deepseek platform)
ZAI_API_KEY=(get this from zai platform)
OPENROUTER_API_KEY=(get this from openrouter platform)
GITHUB_MCP_PAT=(generate pat from github)

# Downstream tokens: what a client must present to use a gateway route. One token
# per route, shared by every development environment -- there is no per-client
# identity here, so a token that leaks is rotated in this file and in every
# client's config at once. Random is the only requirement:
#   openssl rand -hex 24
DOWNSTREAM_DEEPSEEK_SEARCH_TOKEN=(generate this randomly)
DOWNSTREAM_GITHUB_MCP_TOKEN=(generate this randomly)
DOWNSTREAM_PLAYWRIGHT_MCP_TOKEN=(generate this randomly)
