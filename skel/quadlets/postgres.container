[Unit]
Description=Local PostgreSQL development database

[Container]
Image=postgisvec.build
EnvironmentFile=@REPO_ROOT@/installed/envars/postgres.env
Volume=@REPO_ROOT@/installed/data/postgres:/var/lib/postgresql:U,Z
Network=devnetng.network
PublishPort=127.0.0.1:5432:5432/tcp
PublishPort=[::1]:5432:5432/tcp

[Install]
WantedBy=default.target

# Low priority for development database
[Service]
Restart=on-failure
RestartSec=30s
MemoryMax=512M
