# Podman Quadlet for the Forgejo MCP server.
#
# Quadlet names the container systemd-forgejomcp (no ContainerName=), and that
# name is the Host header the gateway sends when it proxies to it. It has to
# appear in FORGEJO_MCP_ALLOWED_HOSTS or the request is refused with 403: the
# server matches the Host header exactly, with no wildcard, and a
# network-reachable bind refuses to start at all without a list.
#
# Nothing is published, same as playwrightmcp. Clients reach this server through
# the gateway's /mcp/forgejo route on port 4000
# (skel/data/agentgateway/config.yaml, route forgejo-mcp-proxy), so every
# MCP server in this stack is one port and one firewall rule.
#
# Through the gateway, the Authorization header that arrives here is the
# gateway's, not the client's: /mcp/forgejo requires a client's surrogate token
# and replaces it with the real FORGEJO_ACCESS_TOKEN before proxying, so this
# server reads that header and passes it on to Forgejo (see the route in
# skel/data/agentgateway/config.yaml). That token is not in this unit's
# EnvironmentFile and does not need to be -- checked against 3.4.0, the server
# starts and serves with no token of its own (`token_configured: false`), which
# is what keeps the Forgejo credential in the gateway's env file alone.
#
# FORGEJO_MCP_ALLOW_OPERATOR_TOKEN_FALLBACK=0 refuses the other path in: a
# container on devnetng that sends no Authorization header. With no operator
# token in this container the fallback would have nothing to serve anyway; keep
# it off rather than rely on that.
#
# FORGEJO_MCP_ALLOWED_HOSTS still matters: it decides which Host this server
# answers to, and a name missing from it is a 403 on every request. Through the
# gateway the Host is the backend's own name (systemd-forgejomcp:8080), which the
# env template already declares -- see the env template, and README
# "Forgejo MCP".
#
# No [Unit] dependency ordering against the rest of the stack: this unit dials
# its Forgejo instance at startup and exits non-zero when it cannot reach it, so
# under the shipped skel/envars/forgejomcp.env seed it restarts every RestartSec
# until FORGEJO_URL is filled in. That is the intended
# failure mode and it is isolated: nothing else in the stack wants this unit.
#
# No RunInit=: the image already runs catatonit as PID 1, so `podman --init`
# would put a second init ahead of it.

[Unit]
Description=Forgejo MCP server over streamable HTTP

[Container]
Image=forgejomcp.build
EnvironmentFile=@REPO_ROOT@/installed/envars/forgejomcp.env
Network=devnetng.network

[Install]
WantedBy=default.target

[Service]
Restart=on-failure
RestartSec=30s
