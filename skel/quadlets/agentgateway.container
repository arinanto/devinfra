# Podman Quadlet for the agent gateway.
#
# @REPO_ROOT@ is substituted by scripts/setup.sh when this file is seeded into
# installed/quadlets: it is this checkout's absolute path, baked in at that
# moment, not a systemd specifier. See skel/quadlets/README.
#
# The gateway is the one thing every development environment has to reach, so in
# this stack it is also the one unit whose agent listener is published: the
# `agent` gateway (port 4000) carries the OpenAI-compatible LLM API, the
# /proxy/deepseek route and the MCP proxies. devstack kept it network-internal
# because its only client was the fakevm on devnetng; here the client is a
# whatever-machine dev environment that cannot resolve devnetng names, so
# loopback is the floor and a tunnel or a private network is how it gets further
# (see README, "Reaching the stack from another machine").
#
# Loopback is the default, not a load-bearing wall: the LLM listener is fail-closed
# (`llm.policies.apiKey` is `mode: strict` with `keys: []`, and strict with an
# empty key list refuses every request until virtual keys are created in the
# dashboard), and every MCP route above this port carries its own token. So
# widening 4000 to a private interface is a supported edit -- see README,
# "Reaching the stack from another machine". What must never change is the mode:
# `optional` (the gateway's default when omitted) or `permissive` admits keyless
# requests, and then anything that can reach this port can spend the provider
# keys in installed/envars/agentgateway.env.
#
# The `user` gateway (38080) is the admin UI, behind HTTP basic auth from
# installed/data/agentgateway/agwadmins.htpasswd. It stays on loopback in every
# shape: it is what mints those virtual keys and edits the routes, so publishing
# it would hand out the keys the LLM listener is gated with.

[Unit]
Description=Agent gateway: LLM proxy, MCP proxies, admin UI

[Container]
Image=cr.agentgateway.dev/agentgateway:v1.7.0
RunInit=true
EnvironmentFile=@REPO_ROOT@/installed/envars/agentgateway.env
Volume=@REPO_ROOT@/installed/data/agentgateway:/config:U,Z
Network=devnetng.network
PublishPort=127.0.0.1:38080:38080/tcp
PublishPort=[::1]:38080:38080/tcp
PublishPort=127.0.0.1:4000:4000/tcp
PublishPort=[::1]:4000:4000/tcp

[Install]
# Infrastructure, not a disposable environment: enabled once, it comes back
# after a reboot without anyone logging in. `scripts/manage-stack.sh up` starts
# it without enabling.
WantedBy=default.target

[Service]
Restart=on-failure
RestartSec=30s
MemoryMax=512M
