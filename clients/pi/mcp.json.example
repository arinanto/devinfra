{
  "mcpServers": {
    "github": {
      "url": "http://127.0.0.1:4000/mcp/github",
      "headers": {
        "Authorization": "Bearer <DOWNSTREAM_GITHUB_MCP_TOKEN from envars/agentgateway.env>"
      },
      "exposure": "deferred",
      "timeout": 60,
      "description": "GitHub through the agent gateway: search repositories, code, commits, issues and pull requests, and read file contents, commits, releases, tags, teams and users. The GitHub PAT is held by the gateway, not by this machine. That PAT is READ-ONLY, so the mutating tools (create_repository, create_or_update_file, push_files, delete_file, create_branch, merge_pull_request, issue_write, pull_request_review_write) fail with a 403 from GitHub - do not plan any write or mutation through this server."
    },
    "playwright-browser": {
      "url": "http://127.0.0.1:4000/mcp/playwright",
      "headers": {
        "Authorization": "Bearer <DOWNSTREAM_PLAYWRIGHT_MCP_TOKEN from envars/agentgateway.env>"
      },
      "exposure": "deferred",
      "timeout": 120,
      "description": "Headless Chromium on the infrastructure host, through the agent gateway. Screenshots and downloads are written on the infrastructure host under data/playwrightmcp/, not here: pass an absolute path under /mnt/playwrightmcp to a tool that saves a file, and read the result on the infrastructure side. Relative paths and any path outside /mnt/playwrightmcp fail."
    },
    "forgejo": {
      "url": "http://127.0.0.1:4000/mcp/forgejo",
      "headers": {
        "Authorization": "Bearer <your own Forgejo access token, read-only>"
      },
      "exposure": "deferred",
      "timeout": 60,
      "description": "Forgejo through the agent gateway: search repositories, read issues and pull requests, and read repo contents on the infrastructure host's forge. The credential is YOUR OWN Forgejo token, not the operator's and not a gateway token - the forgejomcp unit runs with FORGEJO_MCP_ALLOW_OPERATOR_TOKEN_FALLBACK=0, so a request without an Authorization header is refused rather than served with somebody else's identity. The gateway forwards this header untouched; that is why this route, unlike github and playwright-browser, has no DOWNSTREAM_* token of its own. With a read-only token the mutating tools fail with an ordinary error from Forgejo; do not plan any write or mutation through this server."
    }
  }
}
