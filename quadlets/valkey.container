[Unit]
Description=Local Valkey development cache

[Container]
Image=docker.io/valkey/valkey:9-trixie
Volume=%h/Containers/devinfra/data/valkey:/data:U,Z
Network=devnetng.network
PublishPort=127.0.0.1:6379:6379/tcp
PublishPort=[::1]:6379:6379/tcp
Exec=valkey-server --save 60 1 --appendonly yes

[Install]
WantedBy=default.target

# Low priority for development database
[Service]
Restart=on-failure
RestartSec=30s
MemoryMax=512M
